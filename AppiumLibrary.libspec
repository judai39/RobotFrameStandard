<kw name="Get Text" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="461">
<arguments repr="locator, first_only: bool = True">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="locator">
<name>locator</name>
</arg>
<arg kind="POSITIONAL_OR_NAMED" required="false" repr="first_only: bool = True">
<name>first_only</name>
<type name="bool" typedoc="boolean"/>
<default>True</default>
</arg>
</arguments>
<doc>&lt;p&gt;Returns the text of the element with the &lt;code&gt;locator&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;Args:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;code&gt;locator&lt;/code&gt;: locator of the element. For hybrid and mobile browser use &lt;span class="name"&gt;xpath&lt;/span&gt; locator, as others might cause problems.&lt;/li&gt;
&lt;li&gt;&lt;code&gt;first_only&lt;/code&gt;: allows to get the text from the 1st match (default) or a list containing all matches.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;Examples:&lt;/p&gt;
&lt;table border="1"&gt;
&lt;tr&gt;
&lt;td&gt;${text}&lt;/td&gt;
&lt;td&gt;Get Text&lt;/td&gt;
&lt;td&gt;//*[contains(@text,'foo')]&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;@{text}&lt;/td&gt;
&lt;td&gt;Get Text&lt;/td&gt;
&lt;td&gt;//*[contains(@text,'foo')]&lt;/td&gt;
&lt;td&gt;${False}&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</doc>
<shortdoc>Returns the text of the element with the ``locator``.</shortdoc>
</kw>
<kw name="Get Webelement" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="345">
<arguments repr="locator">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="locator">
<name>locator</name>
</arg>
</arguments>
<doc>&lt;p&gt;Returns the first &lt;a href="http://selenium-python.readthedocs.io/api.html#module-selenium.webdriver.remote.webelement"&gt;WebElement&lt;/a&gt; object matching &lt;code&gt;locator&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;Example:&lt;/p&gt;
&lt;table border="1"&gt;
&lt;tr&gt;
&lt;td&gt;${element}&lt;/td&gt;
&lt;td&gt;Get Webelement&lt;/td&gt;
&lt;td&gt;id=my_element&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Click Element&lt;/td&gt;
&lt;td&gt;${element}&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</doc>
<shortdoc>Returns the first [http://selenium-python.readthedocs.io/api.html#module-selenium.webdriver.remote.webelement|WebElement] object matching ``locator``.</shortdoc>
</kw>
<kw name="Get Webelement In Webelement" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="377">
<arguments repr="element, locator">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="element">
<name>element</name>
</arg>
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="locator">
<name>locator</name>
</arg>
</arguments>
<doc>&lt;p&gt;Returns a single &lt;a href="http://selenium-python.readthedocs.io/api.html#module-selenium.webdriver.remote.webelement"&gt;WebElement&lt;/a&gt; object matching &lt;code&gt;locator&lt;/code&gt; that is a child of the argument &lt;code&gt;element&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;This is useful when your HTML doesn't properly have id or name elements on all elements. This way the user can find an element with a tag and then search that element's children.&lt;/p&gt;</doc>
<shortdoc>Returns a single [http://selenium-python.readthedocs.io/api.html#module-selenium.webdriver.remote.webelement|WebElement] object matching ``locator`` that is a child of the argument ``element``.</shortdoc>
</kw>
<kw name="Get Webelements" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="397">
<arguments repr="locator">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="locator">
<name>locator</name>
</arg>
</arguments>
<doc>&lt;p&gt;Returns a list of &lt;a href="http://selenium-python.readthedocs.io/api.html#module-selenium.webdriver.remote.webelement"&gt;WebElement&lt;/a&gt; objects matching &lt;code&gt;locator&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;Example:&lt;/p&gt;
&lt;table border="1"&gt;
&lt;tr&gt;
&lt;td&gt;@{elements}&lt;/td&gt;
&lt;td&gt;Get Webelements&lt;/td&gt;
&lt;td&gt;id=my_element&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Click Element&lt;/td&gt;
&lt;td&gt;@{elements}[2]&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</doc>
<shortdoc>Returns a list of [http://selenium-python.readthedocs.io/api.html#module-selenium.webdriver.remote.webelement|WebElement] objects matching ``locator``.</shortdoc>
</kw>
