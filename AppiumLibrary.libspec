<arguments repr="">
</arguments>
<doc>&lt;p&gt;Opens and expands an Android device's notification drawer.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Android only.&lt;/b&gt;&lt;/p&gt;</doc>
<shortdoc>Opens and expands an Android device's notification drawer.</shortdoc>
</kw>
<kw name="Page Should Contain Element" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="145">
<arguments repr="locator, loglevel=INFO">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="locator">
<name>locator</name>
</arg>
<arg kind="POSITIONAL_OR_NAMED" required="false" repr="loglevel=INFO">
<name>loglevel</name>
<default>INFO</default>
</arg>
</arguments>
<doc>&lt;p&gt;Verifies that the current page contains the element with the &lt;code&gt;locator&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;Args:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;code&gt;locator&lt;/code&gt;: locator of the element that the page should contain&lt;/li&gt;
&lt;li&gt;&lt;code&gt;loglevel&lt;/code&gt;: if this keyword fails, it automatically logs the page source using the the given loglevel. Set this argument to &lt;a href="#type-None" class="name"&gt;NONE&lt;/a&gt; to disable logging.&lt;/li&gt;
&lt;/ul&gt;</doc>
<shortdoc>Verifies that the current page contains the element with the ``locator``.</shortdoc>
</kw>
<kw name="Page Should Contain Text" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="120">
<arguments repr="text, loglevel=INFO">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="text">
<name>text</name>
</arg>
<arg kind="POSITIONAL_OR_NAMED" required="false" repr="loglevel=INFO">
<name>loglevel</name>
<default>INFO</default>
</arg>
</arguments>
<doc>&lt;p&gt;Verifies that the current page contains &lt;code&gt;text&lt;/code&gt;.&lt;/p&gt;
&lt;p&gt;Args:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;code&gt;text&lt;/code&gt;: the text that the page should contain&lt;/li&gt;
&lt;li&gt;&lt;code&gt;loglevel&lt;/code&gt;: if this keyword fails, it automatically logs the page source using the the given loglevel. Set this argument to &lt;a href="#type-None" class="name"&gt;NONE&lt;/a&gt; to disable logging.&lt;/li&gt;
&lt;/ul&gt;</doc>
<shortdoc>Verifies that the current page contains ``text``.</shortdoc>
</kw>
<kw name="Page Should Not Contain Element" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="158">
<arguments repr="locator, loglevel=INFO">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="locator">
<name>locator</name>
</arg>
<arg kind="POSITIONAL_OR_NAMED" required="false" repr="loglevel=INFO">
<name>loglevel</name>
<default>INFO</default>
</arg>
</arguments>
<doc>&lt;p&gt;Verifies that the current page does not contain the element with the &lt;code&gt;locator&lt;/code&gt;.&lt;/p&gt;
