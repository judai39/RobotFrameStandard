<kw name="Go To Url" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_applicationmanagement.py" lineno="383">
<arguments repr="url">
<arg kind="POSITIONAL_OR_NAMED" required="true" repr="url">
<name>url</name>
</arg>
</arguments>
<doc>&lt;p&gt;Opens the &lt;code&gt;url&lt;/code&gt; in the default web browser.&lt;/p&gt;
&lt;p&gt;Example:&lt;/p&gt;
&lt;table border="1"&gt;
&lt;tr&gt;
&lt;td&gt;Open Application&lt;/td&gt;
&lt;td&gt;&lt;a href="http://localhost:4755/wd/hub"&gt;http://localhost:4755/wd/hub&lt;/a&gt;&lt;/td&gt;
&lt;td&gt;platformName=iOS&lt;/td&gt;
&lt;td&gt;platformVersion=7.0&lt;/td&gt;
&lt;td&gt;deviceName='iPhone Simulator'&lt;/td&gt;
&lt;td&gt;browserName=Safari&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Go To URL&lt;/td&gt;
&lt;td&gt;&lt;a href="http://m.webapp.com"&gt;http://m.webapp.com&lt;/a&gt;&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;td&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</doc>
<shortdoc>Opens the ``url`` in the default web browser.</shortdoc>
</kw>
<kw name="Hide Keyboard" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="101">
<arguments repr="key_name=None">
<arg kind="POSITIONAL_OR_NAMED" required="false" repr="key_name=None">
<name>key_name</name>
<default>None</default>
</arg>
</arguments>
<doc>&lt;p&gt;Hides the software keyboard on the device if it is currently visible.&lt;/p&gt;
&lt;p&gt;Args:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;code&gt;key_name&lt;/code&gt; (iOS only): the name of the key to press to dismiss the keyboard.&lt;/li&gt;
&lt;/ul&gt;
&lt;p&gt;On Android, this argument is ignored.&lt;/p&gt;
&lt;p&gt;Examples:&lt;/p&gt;
&lt;table border="1"&gt;
&lt;tr&gt;
&lt;td&gt;Hide Keyboard&lt;/td&gt;
&lt;td&gt;Return&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Hide Keyboard&lt;/td&gt;
&lt;td&gt;Done&lt;/td&gt;
&lt;/tr&gt;
&lt;/table&gt;</doc>
<shortdoc>Hides the software keyboard on the device if it is currently visible.</shortdoc>
</kw>
<kw name="Input Password" source="E:\Project\RobotFrameworkStandard\.venv\Lib\site-packages\AppiumLibrary\keywords\_element.py" lineno="79">
